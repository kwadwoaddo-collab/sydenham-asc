---
import Icon from "../components/Icon.astro";
const {
  title = "Sydenham After School Club",
  description = "Caring after school club and expert tuition in Sydenham SE26. Wraparound childcare 7am–9pm, school drop-offs and pick-ups, and GCSE & SATs tuition. Book your child's place today.",
  active = "",
} = Astro.props;

const nav = [
  { href: "/after-school-club", label: "After School Club", key: "club" },
  { href: "/tuition", label: "Tuition & GCSE", key: "tuition" },
  { href: "/fees", label: "Fees", key: "fees" },
  { href: "/join-us", label: "Join the Team", key: "join" },
  { href: "/about", label: "About", key: "about" },
  { href: "/contact", label: "Contact", key: "contact" },
];
---

<!DOCTYPE html>
<html lang="en-GB">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,500;9..144,600;9..144,700&family=Inter:wght@400;500;600;700&display=swap" />
  <link rel="stylesheet" href="/styles.css" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <meta name="theme-color" content="#2c2a26" />
  <link rel="canonical" href={`https://sydenhamasc.co.uk${Astro.url.pathname}`} />

  <!-- Open Graph -->
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="website" />
  <meta property="og:url" content={`https://sydenhamasc.co.uk${Astro.url.pathname}`} />

  <!-- LocalBusiness structured data -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "ChildCare",
    "name": "Sydenham After School Club",
    "image": "https://sydenhamasc.co.uk/og-image.jpg",
    "@id": "https://sydenhamasc.co.uk",
    "url": "https://sydenhamasc.co.uk",
    "telephone": "+447584874710",
    "email": "info@sydenhamasc.co.uk",
    "address": {
      "@type": "PostalAddress",
      "streetAddress": "105 Sydenham Road",
      "addressLocality": "London",
      "postalCode": "SE26 5UA",
      "addressCountry": "GB"
    },
    "openingHoursSpecification": [{
      "@type": "OpeningHoursSpecification",
      "dayOfWeek": ["Monday","Tuesday","Wednesday","Thursday","Friday"],
      "opens": "07:00", "closes": "21:00"
    }],
    "areaServed": "Sydenham, Forest Hill, Penge, Catford SE26"
  })} />
</head>
<body>
  <header class="site-header">
    <div class="container nav">
      <a class="brand" href="/">
        <img src="/photos/logo.png" alt="Sydenham After School Club" class="brand-logo" />
      </a>
      <ul class="nav-links" id="navLinks">
        {nav.map((item) => (
          <li><a href={item.href} class={active === item.key ? "active" : ""}>{item.label}</a></li>
        ))}
      </ul>
      <div class="nav-cta">
        <a href="/join-us" class="btn btn-outline">We're Hiring</a>
        <a href="/contact" class="btn btn-primary">Book a Place</a>
        <button class="nav-toggle" id="navToggle" aria-label="Menu">☰</button>
      </div>
    </div>
  </header>

  <main>
    <slot />
  </main>

  <footer class="site-footer">
    <div class="container">
      <div class="footer-grid">
        <div>
          <a class="brand" href="/" style="background:#fff; border-radius:12px; padding:10px 16px; display:inline-flex;">
            <img src="/photos/logo.png" alt="Sydenham After School Club" class="brand-logo" />
          </a>
          <p style="margin-top:14px; max-width: 320px;">
            A safe, friendly after school club and tuition centre in the heart of Sydenham —
            trusted by local families for over ten years.
          </p>
          <img src="/photos/ofsted.svg" alt="Ofsted registered" style="height:58px; width:auto; margin-top:18px; background:#fff; border-radius:10px; padding:6px 12px;" />
          <!-- TODO: replace # with your real profile URLs once the pages exist -->
          <div class="social-row">
            <a href="#" target="_blank" rel="noopener" aria-label="Facebook">
              <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="12" fill="#1877F2"/><path fill="#fff" d="M15.5 8.5h-1.6c-.5 0-1 .3-1 1v1.4H15l-.3 2.3h-1.8V19h-2.3v-5.8H9V10.9h1.6V9.2c0-1.6 1-2.7 2.6-2.7h1.8v2z"/></svg>
            </a>
            <a href="#" target="_blank" rel="noopener" aria-label="Instagram">
              <svg viewBox="0 0 24 24">
                <defs>
                  <radialGradient id="igGrad" cx="30%" cy="107%" r="150%">
                    <stop offset="0%" stop-color="#fdf497"/>
                    <stop offset="15%" stop-color="#fdf497"/>
                    <stop offset="45%" stop-color="#fd5949"/>
                    <stop offset="60%" stop-color="#d6249f"/>
                    <stop offset="90%" stop-color="#285AEB"/>
                  </radialGradient>
                </defs>
                <circle cx="12" cy="12" r="12" fill="url(#igGrad)"/>
                <rect x="7" y="7" width="10" height="10" rx="3" fill="none" stroke="#fff" stroke-width="1.4"/>
                <circle cx="12" cy="12" r="2.6" fill="none" stroke="#fff" stroke-width="1.4"/>
                <circle cx="15.2" cy="8.6" r="0.7" fill="#fff"/>
              </svg>
            </a>
            <a href="#" target="_blank" rel="noopener" aria-label="X (Twitter)">
              <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="12" fill="#fff"/><path fill="#000" transform="translate(4.2,4.2) scale(0.62)" d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
            </a>
          </div>
        </div>
        <div>
          <h4>Explore</h4>
          <ul class="footer-links">
            <li><a href="/after-school-club">After School Club</a></li>
            <li><a href="/tuition">Tuition &amp; GCSE</a></li>
            <li><a href="/fees">Fees</a></li>
            <li><a href="/join-us">Join the Team</a></li>
            <li><a href="/about">About Us</a></li>
          </ul>
        </div>
        <div>
          <h4>Get in Touch</h4>
          <ul class="footer-links">
            <li><a href="tel:07584874710">📞 075 8487 4710</a></li>
            <li><a href="tel:02036213942">☎️ 020 3621 3942</a></li>
            <li><a href="mailto:info@sydenhamasc.co.uk">✉️ info@sydenhamasc.co.uk</a></li>
            <li>📍 105 Sydenham Road,<br />London SE26 5UA</li>
          </ul>
        </div>
      </div>
      <div class="footer-bottom">
        <span>© 2026 Sydenham After School Club. All rights reserved.</span>
        <span>All staff DBS checked &amp; safeguarding trained.</span>
      </div>
    </div>
  </footer>

  <a class="wa-float" href="https://wa.me/447584874710" aria-label="WhatsApp us" target="_blank" rel="noopener">💬</a>

  <script is:inline>
    const t = document.getElementById('navToggle');
    const l = document.getElementById('navLinks');
    if (t && l) t.addEventListener('click', () => l.classList.toggle('open'));
  </script>
</body>
</html>
