---
import Layout from "../layouts/Layout.astro";
---
<Layout title="Tuition & GCSE in Sydenham | Maths & English" active="tuition"
  description="Expert Maths and English tuition in Sydenham SE26. Individualised programmes by GCSE and SATs examiners, small 1:6 groups, sessions Monday to Saturday.">

  <section class="hero">
    <div class="container">
      <span class="eyebrow" style="color:#ffd9a0;">Tuition &amp; GCSE</span>
      <h1>Tuition that stretches every child in exactly the right areas</h1>
      <p>Individualised Maths and English programmes, built by official GCSE and SATs examiners and taught in small groups of no more than six.</p>
      <div class="hero-actions">
        <a href="/contact" class="btn btn-primary">Enquire About Tuition</a>
        <a href="#sessions" class="btn btn-ghost">Session Times</a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="split">
        <div>
          <span class="eyebrow">How our tuition works</span>
          <h2>A programme built around your child</h2>
          <p class="lead" style="max-width:none;">Every child has their own individualised programme of study which strengthens their weaknesses and reinforces their strengths. This ensures children are stretched and challenged in exactly the right areas — never bored, never left behind.</p>
          <p style="margin-top:14px; color:var(--ink-soft);">Sessions last approximately 1 hour and 20 minutes. Our tutors work at a maximum ratio of 1:6, striking the right balance between individual support and independent learning. As children practise and acquire new skills, a tutor is always on hand to encourage, explain or teach a new concept.</p>
        </div>
        <div class="split-media">📚</div>
      </div>
    </div>
  </section>

  <section class="section section-soft">
    <div class="container">
      <div class="grid grid-3">
        <div class="card"><div class="ico">🧮</div><h3>Maths</h3><p>From primary foundations through to GCSE, following a programme developed by official examiners.</p></div>
        <div class="card"><div class="ico">✍️</div><h3>English</h3><p>Reading, writing and comprehension that build genuine confidence and exam readiness.</p></div>
        <div class="card"><div class="ico">🎯</div><h3>SATs &amp; GCSE</h3><p>Targeted preparation for key milestones, with methods trusted by exam markers themselves.</p></div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="split reverse">
        <div class="split-media">👩‍🏫</div>
        <div>
          <span class="eyebrow">Customised tutoring</span>
          <h2>Individual attention, real results</h2>
          <p class="lead" style="max-width:none;">We understand that children in the same year can have very different levels of understanding. Your child gets all the attention they need — we identify the individual gaps and give the guidance that helps every student thrive.</p>
          <ul>
            <li>Seasoned tutors experienced in the British system for decades</li>
            <li>Programmes developed by official GCSE and SATs examiners</li>
            <li>Small groups so no child slips through the cracks</li>
            <li>Regular practice with a tutor always close by</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <section class="section section-soft" id="sessions">
    <div class="container">
      <div class="center mb-3"><span class="eyebrow">Session times</span><h2>When tuition runs</h2></div>
      <div style="max-width:640px; margin:0 auto;">
        <table class="price-table">
          <tr><th>Days</th><th>Sessions</th></tr>
          <tr><td>Monday – Friday</td><td>4:30pm – 5:50pm &nbsp;•&nbsp; 6:00pm – 7:20pm</td></tr>
          <tr><td>Saturday</td><td>10:00am – 11:20am &nbsp;•&nbsp; 11:30am – 12:50pm &nbsp;•&nbsp; 1:00pm – 2:20pm</td></tr>
        </table>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="cta-band">
        <h2>Give your child the edge</h2>
        <p>Tell us your child's year group and the subjects they need support with, and we'll recommend the right sessions.</p>
        <div style="display:flex; gap:14px; justify-content:center; flex-wrap:wrap;">
          <a href="/contact" class="btn btn-navy">Enquire Now</a>
          <a href="https://wa.me/447943118873" class="btn btn-wa" target="_blank" rel="noopener">💬 WhatsApp Us</a>
        </div>
      </div>
    </div>
  </section>

</Layout>
