---
import Layout from "../layouts/Layout.astro";
import Icon from "../components/Icon.astro";
---
<Layout title="Fees | Sydenham After School Club" active="fees"
  description="Clear, simple fees for after school childcare and tuition in Sydenham SE26. Tax-Free Childcare and childcare vouchers welcome.">

  <section class="hero">
    <div class="container">
      <span class="eyebrow">Fees</span>
      <h1>Simple, transparent pricing</h1>
      <p>No hidden costs. Choose the sessions that suit your family, and stretch your budget further with Tax-Free Childcare.</p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="grid grid-2">
        <div>
          <h2 class="mb-2">After School &amp; Holiday Club</h2>
          <table class="price-table">
            <tr><th>Session</th><th>Time</th><th>Price</th></tr>
            <tr><td>Term time (Mon–Fri)</td><td>3pm – 6pm</td><td>£37.50</td></tr>
            <tr><td>Term time (Mon–Fri)</td><td>3pm – 8pm</td><td>£62.50</td></tr>
            <tr><td>Saturday</td><td>9am – 4pm</td><td>£45.00</td></tr>
            <tr><td>Holiday club (Mon–Sat)</td><td>9am – 4pm</td><td>£35.00 / day</td></tr>
          </table>
        </div>
        <div>
          <h2 class="mb-2">Tuition</h2>
          <table class="price-table">
            <tr><th>Session</th><th>Length</th><th>Price</th></tr>
            <tr><td>Maths or English</td><td>1hr 20min</td><td>From £__</td></tr>
            <tr><td>Both subjects</td><td>Two sessions</td><td>From £__</td></tr>
            <tr><td>GCSE / SATs prep</td><td>1hr 20min</td><td>From £__</td></tr>
          </table>
          <p class="form-note" style="margin-top:12px;">Tuition pricing to be confirmed — ask us for the current rate for your child's year group.</p>
        </div>
      </div>
      <p class="form-note center" style="margin-top:20px;">Fees shown as a guide and may change. Please confirm current rates when you book. Siblings and multi-session discounts may be available — just ask.</p>
    </div>
  </section>

  <section class="section section-soft">
    <div class="container">
      <div class="split">
        <div>
          <span class="eyebrow">Save up to 20%</span>
          <h2>Tax-Free Childcare &amp; vouchers welcome</h2>
          <p class="lead" style="max-width:none;">For eligible families, the government's Tax-Free Childcare scheme tops up what you pay: for every £8 you put in, the government adds £2 — up to £2,000 per child each year. We also accept childcare vouchers from many employers.</p>
          <ul>
            <li>Works for our after school and holiday club sessions</li>
            <li>Available for children up to 11 (or 16 if disabled)</li>
            <li>We'll help you set it up — just ask</li>
          </ul>
          <p style="margin-top:16px;"><a href="https://www.gov.uk/tax-free-childcare" target="_blank" rel="noopener" class="btn btn-outline" style="padding:10px 22px;">Check your eligibility on GOV.UK →</a></p>
        </div>
        <div class="split-media"><Icon name="pound" size={92} /></div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="cta-band">
        <h2>Questions about fees?</h2>
        <p>We're happy to talk through options and find the right fit for your family and budget.</p>
        <div style="display:flex; gap:14px; justify-content:center; flex-wrap:wrap;">
          <a href="/contact" class="btn btn-navy">Get in Touch</a>
          <a href="https://wa.me/447943118873" class="btn btn-wa" target="_blank" rel="noopener">WhatsApp Us</a>
        </div>
      </div>
    </div>
  </section>

</Layout>
