---
import Layout from "../layouts/Layout.astro";
import Icon from "../components/Icon.astro";
---
<Layout title="Sydenham After School Club | Childcare & Tuition in SE26" active="home">

  <!-- HERO -->
  <section class="hero">
    <div class="container hero-grid">
      <div class="hero-copy">
        <span class="eyebrow">Aspire · Achieve · Excel</span>
        <h1>A warm, happy place for your child after school</h1>
        <p>Trusted childcare and expert tuition in the heart of Sydenham. We collect from local schools, keep your child happy until 8pm, and help them shine in Maths, English and beyond.</p>
        <div class="hero-actions">
          <a href="/contact" class="btn btn-primary">Book a Place</a>
          <a href="/after-school-club" class="btn btn-outline">See How It Works</a>
        </div>
        <div class="hero-badges">
          <span class="hero-badge"><span class="dot"><Icon name="shield" size={17} /></span> DBS-checked staff</span>
          <span class="hero-badge"><span class="dot"><Icon name="clock" size={17} /></span> Open until 8pm</span>
          <span class="hero-badge"><span class="dot"><Icon name="bus" size={17} /></span> School pick-ups</span>
        </div>
      </div>

      <div class="hero-visual">
        <div class="hero-photo">
          <div class="hero-medallion">
            <span class="m-s">S</span>
            <span class="m-t">Aspire · Achieve · Excel</span>
          </div>
        </div>
        <div class="float-card fc-rating">
          <div class="fc-ic" style="background:#fff3df;color:var(--accent-dark);"><Icon name="heart" size={20} /></div>
          <div>
            <div class="stars-row">★★★★★</div>
            <span>Loved by local parents</span>
          </div>
        </div>
        <div class="float-card fc-spaces">
          <div class="fc-ic" style="background:#e4f6ec;color:#1f8a4c;"><Icon name="check" size={20} /></div>
          <div><b>Spaces available</b><span>Enrolling now</span></div>
        </div>
        <div class="float-card fc-years">
          <div class="fc-ic" style="background:#fff3df;color:var(--accent-dark);"><Icon name="star" size={20} /></div>
          <div><b>8+ years</b><span>Serving Sydenham</span></div>
        </div>
      </div>
    </div>
  </section>

  <!-- TWO PILLARS -->
  <section class="section">
    <div class="container">
      <div class="center mb-3">
        <span class="eyebrow">What we offer</span>
        <h2>Two ways we support your family</h2>
        <p class="lead">Wraparound childcare after school, plus focused tuition that builds real confidence — under one roof.</p>
      </div>
      <div class="grid grid-2">
        <div class="card">
          <div class="ico"><Icon name="smile" size={28} /></div>
          <h3>After School Club</h3>
          <p>Quality childcare in a safe, stimulating environment from 3pm to 8pm. Your child relaxes, plays, makes friends from other schools, and gets help with homework — while you finish your day.</p>
          <p class="mt-1"><a href="/after-school-club" class="btn btn-outline" style="padding:10px 22px;">Explore the Club →</a></p>
        </div>
        <div class="card">
          <div class="ico green"><Icon name="book" size={28} /></div>
          <h3>Tuition &amp; GCSE</h3>
          <p>Individualised Maths and English programmes designed by official GCSE and SATs examiners. Small groups of up to six, so every child gets the attention they need to thrive.</p>
          <p class="mt-1"><a href="/tuition" class="btn btn-outline" style="padding:10px 22px;">Explore Tuition →</a></p>
        </div>
      </div>
    </div>
  </section>

  <!-- WHY CHOOSE -->
  <section class="section section-soft">
    <div class="container">
      <div class="split">
        <div class="split-media"><Icon name="cap" size={92} /></div>
        <div>
          <span class="eyebrow">Why families choose us</span>
          <h2>Eight years of helping Sydenham's children shine</h2>
          <p class="lead" style="max-width:none;">Our seasoned tutors have taught the British system for decades. We're in a prime, easy-to-reach location and open every day of the week — always here when you need us.</p>
          <ul>
            <li>Every child gets an individual programme — because children in the same year learn differently</li>
            <li>Small 1:6 tuition groups balance personal support with independent learning</li>
            <li>A calm change of scene after school, so worries from the day are left behind</li>
            <li>Friendships form across schools that would never happen otherwise</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- STATS -->
  <section class="section">
    <div class="container">
      <div class="grid grid-4">
        <div class="stat"><div class="num">8+</div><div class="lbl">Years in Sydenham</div></div>
        <div class="stat"><div class="num">1:6</div><div class="lbl">Max tuition ratio</div></div>
        <div class="stat"><div class="num">3–8pm</div><div class="lbl">After school hours</div></div>
        <div class="stat"><div class="num">100%</div><div class="lbl">DBS-checked staff</div></div>
      </div>
    </div>
  </section>

  <!-- TESTIMONIAL -->
  <section class="section section-soft">
    <div class="container center">
      <span class="eyebrow">From our families</span>
      <h2>Loved by local parents</h2>
      <div class="card" style="max-width:720px; margin:24px auto 0;">
        <div style="color:var(--accent);letter-spacing:3px;font-size:1.2rem;margin-bottom:10px;">★★★★★</div>
        <p style="font-size:1.2rem; color:var(--ink);">"If you want to see how the things you read in books really work in life, come to Sydenham. The tutors genuinely care and my child actually looks forward to going."</p>
        <p class="mt-2" style="font-weight:800; color:var(--navy);">— A Sydenham parent</p>
      </div>
      <p class="form-note" style="margin-top:14px;">More reviews coming soon — we'll link our Google reviews here.</p>
    </div>
  </section>

  <!-- CTA -->
  <section class="section">
    <div class="container">
      <div class="cta-band">
        <h2>Ready to book your child's place?</h2>
        <p>Spaces fill up fast, especially for after school pick-ups. Get in touch today and we'll walk you through everything.</p>
        <div style="display:flex; gap:14px; justify-content:center; flex-wrap:wrap;">
          <a href="/contact" class="btn btn-navy">Book a Place</a>
          <a href="https://wa.me/447943118873" class="btn btn-wa" target="_blank" rel="noopener">WhatsApp Us</a>
        </div>
      </div>
    </div>
  </section>

</Layout>
