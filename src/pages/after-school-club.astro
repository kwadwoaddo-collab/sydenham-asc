---
import Layout from "../layouts/Layout.astro";
---
<Layout title="After School Club in Sydenham | Childcare 3–8pm" active="club"
  description="Safe, stimulating after school childcare in Sydenham SE26, open 3pm–8pm. School pick-up service, homework help, activities and DBS-checked staff.">

  <section class="hero">
    <div class="container">
      <span class="eyebrow" style="color:#ffd9a0;">After School Club</span>
      <h1>Childcare that feels like a home from home</h1>
      <p>Open 3pm to 8pm, term time. We pick your child up from school, keep them safe, fed and busy, and give you the flexibility your working day needs.</p>
      <div class="hero-actions">
        <a href="/contact" class="btn btn-primary">Book a Place</a>
        <a href="/fees" class="btn btn-ghost">See Fees</a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="split">
        <div>
          <span class="eyebrow">A safe, stimulating space</span>
          <h2>Where children relax, play and make friends</h2>
          <p class="lead" style="max-width:none;">At Sydenham ASC we offer quality childcare in a safe and stimulating environment. Our club is unique in bringing together children from different schools — building social skills and friendships that last well beyond the school gates.</p>
          <ul>
            <li>A calm change of venue at the end of the school day</li>
            <li>Children mix with peers from other schools, not just their own</li>
            <li>Homework support so evenings at home are yours</li>
            <li>All staff experienced and DBS checked</li>
          </ul>
        </div>
        <div class="split-media">🧸</div>
      </div>
    </div>
  </section>

  <section class="section section-soft">
    <div class="container">
      <div class="center mb-3">
        <span class="eyebrow">Kept busy &amp; happy</span>
        <h2>Plenty to do every afternoon</h2>
      </div>
      <div class="grid grid-3">
        <div class="card"><div class="ico">🎮</div><h3>Games consoles</h3><p>Wii, Xbox and more for supervised downtime and turn-taking fun.</p></div>
        <div class="card"><div class="ico">🎲</div><h3>Board games</h3><p>Classic games that build teamwork, patience and problem-solving.</p></div>
        <div class="card"><div class="ico">🎬</div><h3>Movie days</h3><p>Cosy film sessions and many more activities across the week.</p></div>
        <div class="card"><div class="ico">📝</div><h3>Homework help</h3><p>A quiet space and a helping hand to get schoolwork done.</p></div>
        <div class="card"><div class="ico">🍎</div><h3>Snacks</h3><p>A friendly, well-supervised environment to refuel and unwind.</p></div>
        <div class="card"><div class="ico">🤝</div><h3>New friendships</h3><p>Meet children from schools across Sydenham and the surrounding area.</p></div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="split reverse">
        <div class="split-media">🚸</div>
        <div>
          <span class="eyebrow">School pick-up service</span>
          <h2>We'll collect your child for you</h2>
          <p class="lead" style="max-width:none;">To support parents with work commitments, we offer a pick-up service from local schools. Your child is safely collected and brought straight to the club — no juggling, no rush.</p>
          <p class="form-note">Tell us your child's school and we'll confirm whether we cover the route. <a href="/contact">Get in touch →</a></p>
        </div>
      </div>
    </div>
  </section>

  <section class="section section-soft">
    <div class="container">
      <div class="center mb-3"><span class="eyebrow">Opening hours</span><h2>When we're open</h2></div>
      <div style="max-width:640px; margin:0 auto;">
        <table class="price-table">
          <tr><th>Session</th><th>Days</th><th>Hours</th></tr>
          <tr><td>After School Club</td><td>Monday – Friday</td><td>3:00pm – 8:00pm</td></tr>
          <tr><td>Saturday Club</td><td>Saturday</td><td>9:00am – 4:00pm</td></tr>
          <tr><td>Holiday Club</td><td>Monday – Saturday</td><td>9:00am – 4:00pm</td></tr>
        </table>
        <p class="form-note center" style="margin-top:14px;">Please confirm current session times when you book — holiday club dates follow the school calendar.</p>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="cta-band">
        <h2>Reserve your child's place</h2>
        <p>Pick-up spaces are limited by route and fill quickly. Message us today to check availability.</p>
        <div style="display:flex; gap:14px; justify-content:center; flex-wrap:wrap;">
          <a href="/contact" class="btn btn-navy">Book a Place</a>
          <a href="https://wa.me/447943118873" class="btn btn-wa" target="_blank" rel="noopener">💬 WhatsApp Us</a>
        </div>
      </div>
    </div>
  </section>

</Layout>
